body {
  font-family: Arial, sans-serif;
  background: #f4f4f4;
  display: flex;
  justify-content: center;
  margin-top: 50px;
  transition: background 0.3s, color 0.3s;
}

.container {
  background: white;
  padding: 20px;
  border-radius: 10px;
  width: 300px;
  text-align: center;
  transition: background 0.3s, color 0.3s;
}

#display {
  width: 100%;
  box-sizing: border-box;
  padding: 10px;
  font-size: 24px;
  margin-bottom: 15px;
  text-align: right;
}

.buttons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-bottom: 10px;
}

button {
  padding: 15px;
  font-size: 18px;
  cursor: pointer;
}

/* Dark mode */
.dark-mode {
  background: #121212;
}

.dark-mode .container {
  background: #1e1e1e;
  color: white;
}

.dark-mode #display {
  background: #333;
  color: white;
  border: 1px solid #555;
}
/* Mobile responsiveness */
@media (max-width: 480px) {
  body {
    margin-top: 20px;
    padding: 10px;
  }

  .container {
    width: 100%;
    box-sizing: border-box;
  }

  #display {
    font-size: 20px;
  }

  button {
    padding: 12px;
    font-size: 16px;
  }
}
